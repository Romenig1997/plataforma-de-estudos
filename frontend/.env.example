# Variaveis de ambiente do frontend.
# Copie para .env.local e preencha. O arquivo NAO deve ser commitado.
#
# O prefixo VITE_ e obrigatorio para o que o Vite expoe ao bundle. Tudo que
# comeca com VITE_ fica visivel no navegador: nunca coloque segredos aqui.

# Destino do proxy /api do dev server (nao vai para o bundle).
# Sem esta variavel, o Vite usa http://localhost:8080.
API_PROXY_TARGET=http://localhost:8080

# ---------------------------------------------------------------------------
# Supabase Auth (cadastro, login, sessao e recuperacao de senha)
# ---------------------------------------------------------------------------
# Settings -> API do projeto Supabase. Use um projeto de DESENVOLVIMENTO aqui;
# o de producao fica so nas variaveis do servico publicado.
VITE_SUPABASE_URL=https://<ref-do-projeto>.supabase.co
# Chave PUBLICA (anon ou publishable). NUNCA a service_role / secret key.
VITE_SUPABASE_ANON_KEY=
