# Variaveis de ambiente do backend.
# Copie para .env e preencha. O arquivo .env NAO deve ser commitado.
#
# Nenhuma variavel e obrigatoria na Etapa 0: a aplicacao sobe sem banco,
# porque ainda nao existem entidades nem consultas.

# Porta da aplicacao
SERVER_PORT=8080

# ---------------------------------------------------------------------------
# Conexao com o PostgreSQL do Supabase - ativa na HU05
# ---------------------------------------------------------------------------
# JDBC URL do PostgreSQL do Supabase
DB_URL=
# Usuario do banco (Settings -> Database do painel do Supabase)
DB_USERNAME=
# Senha do banco. NAO e a senha de login do usuario do Supabase.
DB_PASSWORD=