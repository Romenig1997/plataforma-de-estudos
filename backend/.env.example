# Variaveis de ambiente do backend.
# Copie para .env e preencha. O arquivo .env NAO deve ser commitado.
#
# A partir da HU01 as tres variaveis de banco sao OBRIGATORIAS: existe
# entidade a persistir, entao sem DB_URL a aplicacao nao sobe.
#
# O arquivo .env e lido pelo backend porque o application.yml declara
#   spring.config.import: "optional:file:.env[.properties]"
# Sem essa linha o Spring Boot ignora o .env.

# Porta da aplicacao
SERVER_PORT=8080

# Origens que podem chamar a API diretamente, separadas por virgula.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Conexao com o PostgreSQL do Supabase
# ---------------------------------------------------------------------------
# JDBC URL com o driver trocado para jdbc: e com sslmode=require, que e
# obrigatorio: o PostgreSQL do Supabase recusa conexao sem TLS.
# Use a URI do painel (Connect -> Session pooler), convertida para JDBC.
DB_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
# No pooler o usuario leva o identificador do projeto: postgres.<ref>
DB_USERNAME=postgres.<ref-do-projeto>
# Senha do BANCO de dados. NAO e a senha de login do painel do Supabase.
# Definida em Settings -> Database -> Reset your database password.
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Supabase Auth e Storage (HU02/HU03)
# ---------------------------------------------------------------------------
# Senhas, cadastro, login, confirmacao de e-mail e redefinicao de senha ficam
# no Supabase Auth. O backend so confere o access token enviado pelo frontend.
#
# URL do projeto (Settings -> API -> Project URL). OBRIGATORIA.
SUPABASE_URL=https://<ref-do-projeto>.supabase.co
# Chave publica (anon ou publishable). Usada como "apikey" no envio da foto
# ao Storage. Nao e segredo, mas fica aqui para trocar de projeto sem recompilar.
SUPABASE_ANON_KEY=
# SOMENTE para projetos que ainda assinam tokens com o JWT secret legado
# (Settings -> JWT Keys -> Legacy JWT Secret). Projetos com chaves assimetricas
# deixam vazio: a chave publica e lida do JWKS do projeto. E SEGREDO: nunca
# commitar.
SUPABASE_JWT_SECRET=
# Bucket das fotos de perfil, criado por supabase/migrations.
SUPABASE_BUCKET_FOTOS=avatars

# ---------------------------------------------------------------------------
# Extracao de editais via IA (HU07, incremento A)
# ---------------------------------------------------------------------------
# Opcionais: sem elas a aplicacao sobe e a extracao falha com status FALHA
# (o PDF fica salvo e a importacao pode ser reprocessada depois).
#
# tipo: rest (padrao), manual (sugestao local sem chamadas externas) ou fake (apenas testes).
PLATAFORMA_IA_TIPO=rest
# Endpoint "chat completions" do provedor e modelo a usar.
IA_API_URL=https://api.openai.com/v1/chat/completions
IA_MODELO=gpt-4o-mini
# Chave da API. NAO deve ser commitada em hipotese alguma.
IA_API_KEY=
