<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>br.com.romenig</groupId>
    <artifactId>plataforma-de-estudos</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>plataforma-de-estudos</name>
    <description>Plataforma Inteligente de Preparacao para Concursos</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            spring-boot-starter-data-jpa entrou na HU01, quando passou a
            existir entidade a persistir. Na Etapa 0 ele quebrava o
            contexto sem spring.datasource.url ("Failed to determine a
            suitable driver class"); agora a URL vem do ambiente.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            No Spring Boot 4 o MockMvc saiu do spring-boot-starter-test
            (que modularizou o suporte a teste web). Sem este starter o
            AutoConfigureMockMvc nem existe no classpath.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            H2 em escopo de teste: permite validar os criterios de aceite
            da HU01 sem depender do Supabase e sem Docker. O banco real
            de producao continua sendo o PostgreSQL do Supabase.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Perfil de smoke test manual: Sobe a aplicacao de verdade
            (Tomcat + HTTP) contra o H2 em memoria, permitindo validar o
            contrato do endpoint com curl sem Docker e sem credenciais do
            Supabase. O H2 continua em escopo de teste: este perfil apenas
            coloca o driver no classpath de runtime.

            Uso: .\mvnw.cmd -Ph2runtime spring-boot:run
        -->
        <profile>
            <id>h2runtime</id>
            <dependencies>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                    </resource>
                    <resource>
                        <!-- Aplica o application.yml de teste, que aponta para o H2 -->
                        <directory>src/test/resources</directory>
                    </resource>
                </resources>
            </build>
        </profile>
    </profiles>

</project>