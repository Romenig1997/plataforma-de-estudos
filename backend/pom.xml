<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>br.com.romenig</groupId>
    <artifactId>plataforma-de-estudos</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>plataforma-de-estudos</name>
    <description>Plataforma Inteligente de Preparacao para Concursos</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            spring-boot-starter-data-jpa foi adiado para a HU05.

            Motivo comprovado por build: com o starter presente e sem
            spring.datasource.url, o DataSourceAutoConfiguration do
            Spring Boot 4.1.1 tenta criar o HikariDataSource mesmo sem
            nenhuma entidade, e falha com:
                "Failed to determine a suitable driver class"
            Isso derrubava o teste de contexto na Etapa 0. Como ainda nao
            existe entidade nem consulta, o starter nao tem funcao util
            aqui. Ver docs/hu/05-estrutura-de-banco-de-dados.md.
        -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>