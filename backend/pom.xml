<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>br.com.romenig</groupId>
    <artifactId>plataforma-de-estudos</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>plataforma-de-estudos</name>
    <description>Plataforma Inteligente de Preparacao para Concursos</description>

    <properties>
        <java.version>17</java.version>
        <!--
            JWT (entrou na HU02). O Spring Boot nao gerencia esta dependencia,
            entao a versao e declarada aqui. A 0.12.6 e a ultima publicada e
            expoe o mesmo formato de token gerado pela 0.11, entao trocar a
            versao nao invalida os tokens ja emitidos.
        -->
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            spring-boot-starter-data-jpa entrou na HU01, quando passou a
            existir entidade a persistir. Na Etapa 0 ele quebrava o
            contexto sem spring.datasource.url ("Failed to determine a
            suitable driver class"); agora a URL vem do ambiente.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Entrou na HU02 (Sistema de Autenticacao). A Etapa 0 adiou esta
            dependencia de proposito: o SecurityFilterChain padrao bloqueia
            todos os endpoints, e nao havia regra de autorizacao para escrever
            ainda - essa e a HU04.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            JWT. "api" traz a API de compilacao (Jwts, Claims); "impl" e
            "jackson" sao a implementacao e ficam em runtime, porque o codigo
            da aplicacao nunca referencia as classes deles diretamente.
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            PDFBox (entrou na HU07, incremento A): extrai o texto do PDF do
            edital uma pagina por vez, para a IA estruturar com a referencia
            da pagina de origem. Traz fontbox (renderizacao de fontes) como
            dependencia transitiva.
        -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.4</version>
        </dependency>

        <!--
            Flyway entrou na HU05 (Estruturacao de Banco de Dados): o esquema
            passou a ser versionado por migrations em db/migration, deixando de
            ser um schema.sql idempotente.

            No Spring Boot 4 a auto-configuracao saiu do jar do Flyway e virou
            modulo proprio. Por isso o starter e obrigatorio: so flyway-core no
            classpath NAO basta (o Flyway seria ignorado e o Hibernate validaria
            contra um banco vazio). flyway-core traz o motor e o suporte ao H2
            dos testes; flyway-database-postgresql traz o suporte ao PostgreSQL
            do Supabase.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            No Spring Boot 4 o MockMvc saiu do spring-boot-starter-test
            (que modularizou o suporte a teste web). Sem este starter o
            AutoConfigureMockMvc nem existe no classpath.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            H2 em escopo de teste: permite validar os criterios de aceite
            da HU01 sem depender do Supabase e sem Docker. O banco real
            de producao continua sendo o PostgreSQL do Supabase.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Perfil de smoke test manual: Sobe a aplicacao de verdade
            (Tomcat + HTTP) contra o H2 em memoria, permitindo validar o
            contrato do endpoint com curl sem Docker e sem credenciais do
            Supabase. O H2 continua em escopo de teste: este perfil apenas
            coloca o driver no classpath de runtime.

            Uso: .\mvnw.cmd -Ph2runtime spring-boot:run
        -->
        <profile>
            <id>h2runtime</id>
            <dependencies>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
            <build>
                <resources>
                    <resource>
                        <directory>src/main/resources</directory>
                    </resource>
                    <resource>
                        <!-- Aplica o application.yml de teste, que aponta para o H2 -->
                        <directory>src/test/resources</directory>
                    </resource>
                </resources>
            </build>
        </profile>
    </profiles>

</project>
